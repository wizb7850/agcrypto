# Généré par « npm run setup ». Tout fonctionne en local tel quel.

DATABASE_URL=postgres://agcrypto:agcrypto@localhost:55432/agcrypto
PORT=3000
# 127.0.0.1 = API accessible uniquement depuis ce PC (recommandé en local)
HOST=127.0.0.1
# Adresse publique de l'API (liens de paiement, notifications NOWPayments)
PUBLIC_BASE_URL=http://localhost:3000
# Adresse du frontend (liens dans les e-mails)
APP_URL=http://localhost:3001

# demo = paiements fictifs pour tester en local, sans compte NOWPayments
# sandbox / production = vrais appels NOWPayments (remplir les 2 clés ci-dessous)
NOWPAYMENTS_ENV=demo
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ---- Frais (revenus de la plateforme) ----
PAYMENT_FEE_PERCENT=1
WITHDRAWAL_FEE_PERCENT=10
WITHDRAWAL_FIXED_FEES={"usdttrc20":"1","usdterc20":"5","usdtbsc":"1","btc":"0.0001"}

# ---- Limites (équivalent USD) ----
# Compte non vérifié : total encaissable avant vérification ; retraits interdits
LIMIT_UNVERIFIED_RECEIVE_USD=1000
# Compte personnel vérifié : encaissement sur 30 jours, retraits sur 24 h
LIMIT_PERSONAL_RECEIVE_USD_30D=10000
LIMIT_PERSONAL_WITHDRAW_USD_24H=2000
# Compte professionnel vérifié : aucune limite
# Valeur en USD d'une unité de chaque devise de facturation
FX_RATES_USD={"usd":"1","eur":"1.08","gbp":"1.27","chf":"1.13","cad":"0.73","xof":"0.00165","xaf":"0.00165","mad":"0.1"}

# ---- Page de paiement ----
CHECKOUT_CURRENCIES=usdttrc20,usdterc20,usdtbsc,btc,eth,ltc,trx,bnbbsc
INVOICE_TTL_MINUTES=60

# ---- E-mails ----
# Local : Mailpit (lancé par « npm run db »), boîte de réception sur http://localhost:8025
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=agcrypto <no-reply@agcrypto.local>

# ---- Documents de vérification (dossier privé, jamais servi publiquement) ----
UPLOAD_DIR=./storage
