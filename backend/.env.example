# Généré automatiquement par « npm run setup ». Tout fonctionne en local tel quel.

DATABASE_URL=postgres://agcrypto:agcrypto@localhost:55432/agcrypto
PORT=3000
# 127.0.0.1 = API accessible uniquement depuis ce PC (recommandé en local)
HOST=127.0.0.1
PUBLIC_BASE_URL=http://localhost:3000
# Jeton d'accès aux routes /admin (généré automatiquement)
ADMIN_TOKEN=

# demo = paiements fictifs pour tester en local, sans compte NOWPayments
# sandbox / production = vrais appels NOWPayments (remplir les 2 clés ci-dessous)
NOWPAYMENTS_ENV=demo
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# ---- Frais (tes revenus) ----
PAYMENT_FEE_PERCENT=1
WITHDRAWAL_FEE_PERCENT=10
WITHDRAWAL_FIXED_FEES={"usdttrc20":"1","usdterc20":"5","btc":"0.0001"}

# ---- Checkout ----
CHECKOUT_CURRENCIES=usdttrc20,usdterc20,usdtbsc,btc,eth,ltc,trx,bnbbsc
INVOICE_TTL_MINUTES=60
