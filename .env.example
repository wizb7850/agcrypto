DATABASE_URL=postgres://agcrypto:agcrypto@localhost:5432/agcrypto
PORT=3000
# URL publique de l'API (NOWPayments y envoie les notifications IPN)
PUBLIC_BASE_URL=https://ton-domaine.com
# Ton compte NOWPayments (tous les fonds arrivent ici)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_ENV=sandbox
# Commission de la plateforme en pourcentage (ex: 1 = 1 %)
PLATFORM_FEE_PERCENT=1
# Jeton d'accès aux routes /admin (générer : openssl rand -hex 32)
ADMIN_TOKEN=
