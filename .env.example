DATABASE_URL=postgres://agcrypto:agcrypto@localhost:5432/agcrypto
PORT=3000
# URL publique de l'API (NOWPayments y envoie les notifications IPN)
PUBLIC_BASE_URL=https://ton-domaine.com
# Ton compte NOWPayments (tous les fonds arrivent ici)
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_ENV=sandbox
# ---- Frais (tes revenus) ----
# % prélevé sur chaque paiement reçu. Les frais NOWPayments sont déjà déduits par eux en amont.
PAYMENT_FEE_PERCENT=1
# % prélevé sur chaque retrait + frais fixe par devise (pour couvrir les frais réseau d'envoi)
WITHDRAWAL_FEE_PERCENT=10
WITHDRAWAL_FIXED_FEES={"usdttrc20":"1","usdterc20":"5","btc":"0.0001"}
# ---- Checkout ----
CHECKOUT_CURRENCIES=usdttrc20,usdterc20,usdtbsc,btc,eth,ltc,trx,bnbbsc
INVOICE_TTL_MINUTES=60
# Jeton d'accès aux routes /admin (générer : openssl rand -hex 32)
ADMIN_TOKEN=
